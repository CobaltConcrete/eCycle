# Copy to backend/.env. Use the exact URI from Supabase > Connect.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecycle
# Same project URL and publishable key used by the frontend. No signing secret needed.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=5000
# Server key: allow Geocoding API and Routes API; separate from browser key.
GOOGLE_MAPS_API_KEY=
